{
  "schemaVersion": 1,
  "id": "procommands",
  "version": "${version}",
  "name": "ProCommands",
  "icon": "assets/procommands/icon.png",
  "description": "Source engine style voice command menu system to send commands to chat",
  "authors": [
    "ThePro1604"
  ],
  "contributors": [
    "kittheuh"
  ],
  "contact": {
    "sources": "https://github.com/ThePro1604/ProCommands",
    "issues": "https://github.com/ThePro1604/ProCommands/issues"
  },
  "license": "Apache-2.0",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.thepro1604.procommands.client.ProCommandsClient"
    ],
    "modmenu": [
      "io.github.thepro1604.procommands.client.ModMenuConfig"
    ]
  },
  "mixins": [
    {
      "config": "procommands.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}-",
    "cloth-config": ">=${cloth_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
